FROM golang:1.27-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /agent-nexus-api ./cmd/server

# Use debian-slim so Ollama (glibc) works. Alpine uses musl and is incompatible.
FROM debian:bookworm-slim

# Install Node.js 20 via NodeSource — bookworm-slim ships Node 18 which is
# too old for Baileys v7 (requires Node 20+).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata curl git zstd \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

WORKDIR /app
COPY --from=builder /agent-nexus-api .
COPY whatsapp-adapter ./whatsapp-adapter
RUN cd whatsapp-adapter && npm install --omit=dev
COPY start-api.sh .
RUN chmod +x ./start-api.sh

EXPOSE 8080
EXPOSE 18901
CMD ["./start-api.sh"]

