DATABASE_URL=postgres://nexus:nexus@localhost:5432/agent_nexus?sslmode=disable

# Must be 32+ characters
JWT_SECRET=change-me-in-production-32-chars-min!

# Must be exactly 32 characters (AES-256)
ENCRYPTION_KEY=change-me-exactly-32-chars-here!

PORT=8080
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
STORAGE_PATH=./data/files

# Base URL of the frontend app — Nexus AI uses this when generating navigation
# links. Set to your public domain when self-hosting (e.g. https://your-domain.com).
PUBLIC_APP_URL=http://localhost:3000

# Base URL the API is reachable at — used as the redirect base for OAuth flows.
PUBLIC_API_URL=http://localhost:8080

# Google OAuth (optional — leave blank to disable)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# WhatsApp adapter (optional — only needed when using Gateway WhatsApp channels)
# Run the adapter service separately; defaults to http://127.0.0.1:18901
WHATSAPP_ADAPTER_URL=http://127.0.0.1:18901

# Embedding (optional — defaults point to the Ollama bundled in the API Docker image)
# Set EMBED_OLLAMA_URL="" to disable vector embeddings (context retrieval degrades to recency-based)
EMBED_OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Jira native tools (optional, single-tenant fallback — workspace credentials
# set in Settings → Claude Code take precedence). Cloud: base URL + account
# email + API token. Data Center: base URL + PAT, leave JIRA_EMAIL empty.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
