FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY services/api/go.mod services/api/go.sum ./
RUN go mod download
COPY services/api/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /agent-nexus-api ./cmd/server

# Use debian-slim: NodeSource prebuilt Node.js requires glibc; Alpine uses musl.
FROM debian:bookworm-slim

# Install Node.js 20 via NodeSource — bookworm-slim ships Node 18 which is
# too old for Baileys v7 (requires Node 20+).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata curl git zstd \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /agent-nexus-api .
COPY services/api/whatsapp-adapter ./whatsapp-adapter
RUN cd whatsapp-adapter && npm install --omit=dev
COPY services/api/start-api.sh .
RUN chmod +x ./start-api.sh

EXPOSE 8080
EXPOSE 18901
CMD ["./start-api.sh"]
