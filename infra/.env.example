# Copy this file to infra/.env and fill in values before running docker compose.
# infra/.env is git-ignored — never commit real secrets.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be 32+ characters
JWT_SECRET=change-me-to-32-plus-chars-minimum!!

# Must be exactly 32 characters (AES-256-GCM key encryption)
ENCRYPTION_KEY=change-me-exactly-32-bytes!!!!!!

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Leave blank to disable Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Set PUBLIC_APP_URL to your public domain when deploying (e.g. https://your-domain.com).
# Nexus AI uses this to generate correct navigation links.
# PUBLIC_APP_URL=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8080

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Jira→PR pipeline (optional) ───────────────────────────────────────────────
# The runner ships in "stub" mode (simulated sessions, no credentials needed).
# For real Claude Code repo sessions set RUNNER_EXECUTOR=claude and provide:
#RUNNER_EXECUTOR=claude
#GITHUB_TOKEN=ghp_...                   # repo clone/push + PR tools
#ANTHROPIC_API_KEY=sk-ant-...           # or CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`
#RUNNER_CALLBACK_SECRET=generate-a-random-string
# Require a human approval before a session clones/pushes code or opens a PR.
# Default false: the per-repo sessions toggle is the gate, and the pipeline is
# meant to run unattended.
#REQUIRE_SESSION_APPROVAL=true

# ── Security (optional) ──────────────────────────────────────────────────────
# native_http_request blocks private/loopback/link-local destinations by
# default. List internal hosts your agents legitimately call:
#HTTP_TOOL_ALLOW_HOSTS=internal-api.example.com,10.0.0.5
# Per-client request ceilings on the endpoints reachable without credentials
# (0 disables). Defaults: 20 and 120.
#RATE_LIMIT_AUTH_PER_MIN=20
#RATE_LIMIT_INGRESS_PER_MIN=120
# Reverse proxies in front of the API (default 1, for Railway/PaaS). Set 0 when
# the API is exposed directly, or X-Forwarded-For can be forged to dodge limits.
#TRUSTED_PROXY_COUNT=0
# Shared secret for /internal/whatsapp/* — auto-generated per container by
# start-api.sh; set only if the adapter runs outside the API container.
#WHATSAPP_INTERNAL_TOKEN=generate-a-random-string

# ── Corporate TLS interception (optional, local dev only) ────────────────────
# If your network MITMs TLS (containers see SELF_SIGNED_CERT_IN_CHAIN), export
# your gateway's root CA to infra/certs/corp-ca.pem and uncomment:
#RUNNER_EXTRA_CA=/corp-certs/corp-ca.pem
